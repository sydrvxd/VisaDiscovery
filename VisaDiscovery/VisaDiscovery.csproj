<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>VisaDiscovery</AssemblyName>
    <RootNamespace>VisaDiscovery</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>sydrv</Authors>
    <Description>VISA Instrument Discovery Tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Ivi.Visa" Version="11.0.2240.2" />
  </ItemGroup>

</Project>
